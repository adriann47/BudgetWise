# Copy to .env. Never commit actual credentials.
DATABASE_URL=postgresql://budgetwise:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/budgetwise
# Generate a secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
COOKIE_SAME_SITE=lax
# Localhost does not need TLS. Hosted databases use verified TLS automatically.
# DATABASE_SSL=true
# DATABASE_CA_FILE=/absolute/path/to/provider-ca.pem
# Set only when deployed behind a known reverse proxy; see docs/week-2-auth.md.
# TRUST_PROXY_HOPS=1
# The API host normally supplies PORT; local default is 3000.