{
  "name": "budgetwise-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env --watch server.js",
    "db:schema": "npm run db:migrate",
    "db:seed": "node db/no-seed.js",
    "db:migrate": "node --env-file=.env db/migrate.js",
    "db:local:start": "node db/local.js start",
    "db:local:stop": "node db/local.js stop",
    "db:local:status": "node db/local.js status",
    "test": "node --env-file=.env --test --test-concurrency=1 test/auth.test.js",
    "db:runtime:setup": "node --env-file=.env db/setup-runtime.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.13.1"
  }
}
